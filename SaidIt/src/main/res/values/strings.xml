    <!-- Low power mode -->

    <string name="low_power_title">Low power mode</string>
    <string name="low_power_on">Low power: ON</string>
    <string name="low_power_off">Low power: off</string>
    <string name="low_power_hint">Records at 8 kHz: worse quality, a sixth of the data and far fewer wake-ups.</string>
    <string name="low_power_description">For when battery matters more than fidelity. Capture drops to 8 kHz, which is enough to understand speech, so the microphone buffer lasts six times longer between wake-ups, files are a sixth of the size and this screen refreshes less often. Switching it off restores the previous quality. Whatever is in memory is saved before the change, since audio memory cannot survive a format change.</string>
    <string name="notification_low_power_suffix">· low power</string>

    <!-- GPS logging -->

    <string name="gps_title">GPS logging</string>
    <string name="gps_on">GPS log: ON</string>
    <string name="gps_off">GPS log: off</string>
    <string name="gps_hint">Records where you were, saved as a .gpx track beside each recording.</string>
    <string name="gps_description">While Echo is listening, a location fix is taken every few seconds and written out by the same saves as the audio, into a file with the same name and a .gpx extension. Any map or GPS app opens it. Fixes stop with the recording, and gaps in the signal are kept as gaps rather than drawn as straight lines. In low power mode fixes are taken every 30 seconds instead of every 5.</string>
    <string name="gps_permission_needed">Echo needs location permission to log a GPS track.</string>
    <string name="gps_provider_off">GPS is switched off on this device, so no fix will arrive. Turn on location in the system settings.</string>
    <string name="notification_gps_suffix">\u00b7 GPS</string>

