    <string name="screenshot_on">Screenshots: ON</string>
    <string name="screenshot_off">Screenshots: off</string>
    <string name="screenshot_description">Takes a screenshot every so often while the screen is on, using Android\'s screen capture. Android asks you to allow it once and shows a capture indicator the whole time it is on. The permission cannot outlive the app, so screenshots switch off if Echo is stopped and have to be turned on again. Only available while Echo is listening.</string>
    <string name="screenshot_denied">Screen capture was not allowed, so screenshots stay off.</string>
    <string name="screenshot_needs_listening">Start Echo listening first, then turn on screenshots.</string>
    <string name="screenshot_min_label">Minimum seconds between screenshots</string>
