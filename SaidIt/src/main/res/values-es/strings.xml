    <!-- Cámara al agitar -->

    <string name="camera_title">Cámara al agitar</string>
    <string name="camera_on">Captura al agitar: SÍ</string>
    <string name="camera_off">Captura al agitar: no</string>
    <string name="camera_description">Mientras Echo está grabando, agitar el móvil con fuerza y después dejarlo quieto un segundo graba un clip corto con la cámara trasera y otro con la frontal, sin vista previa, guardados junto al audio como archivos .mp4 sin sonido. Hacen falta las dos mitades, y eso es lo que evita que un móvil en el bolsillo grabe todo el día: agitarlo no hace nada hasta que se queda quieto, y estar quieto no hace nada si antes no lo agitaste. El móvil vibra dos veces por clip: dos toques rápidos cuando empieza a grabar y, al terminar, una vibración larga si quedó guardado o dos largas si no se grabó nada. Necesita el permiso de cámara.</string>
    <string name="camera_permission_needed">Echo necesita el permiso de cámara para grabar al agitar.</string>
    <string name="shake_level_title">Fuerza del agitado</string>
    <string name="shake_level_gentle">Suave</string>
    <string name="shake_level_normal">Normal</string>
    <string name="shake_level_hard">Fuerte</string>
    <string name="shake_level_description">Con cuánta fuerza hay que agitar el móvil para que grabe. Súbelo si graba solo mientras lo llevas encima; bájalo si no se entera cuando lo agitas.</string>
    <string name="front_camera_title">Cámara frontal</string>
    <string name="front_camera_on">Cámara frontal: SÍ</string>
    <string name="front_camera_off">Cámara frontal: no</string>
    <string name="front_camera_description">Desactívala para grabar solo con la trasera. La captura al agitar sigue funcionando; la frontal simplemente no participa.</string>
    <string name="clip_seconds_title">Duración del clip (segundos)</string>
    <string name="clip_seconds_description">Cuánto dura cada clip. Un clip corto es un archivo pequeño: tres segundos de una cámara ocupan alrededor de un megabyte.</string>
    <string name="camera_min_title">Segundos mínimos entre clips</string>
    <string name="camera_min_back_label">Cámara trasera (segundos)</string>
