APP_PIN=1234

# Puerto publicado en la maquina, que es el unico que tiene sentido cambiar aqui. Dentro del
# contenedor la aplicacion escucha siempre en el 8080, porque es a donde apuntan el mapeo de
# compose y el proxy de Caddy: moverlo desde .env solo conseguiria que dejaran de encontrarla.
# Ejecutando el binario a mano, fuera de Docker, si vale PORT para elegir en cual escucha.
HOST_PORT=8081

# Token que autoriza la subida de trazas desde Echo. Viaja en la URL, porque es lo unico que la
# aplicacion deja configurar, asi que tiene que ser largo y aleatorio y no un PIN de cuatro
# digitos: generalo con  openssl rand -hex 32
# Vacio o sin definir, /traces responde 503 y no acepta nada.
ECHO_TOKEN=

# Dominio con el que Caddy saca el certificado y sirve HTTP/3.
ECHO_DOMAIN=echo.example.com

# Opcional. Tamano maximo por archivo, en bytes. Por defecto 512 MiB.
# ECHO_MAX_UPLOAD_BYTES=536870912
